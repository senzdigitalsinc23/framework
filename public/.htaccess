# ---------------------------------------------------
# Production-ready .htaccess for PHP Framework
# ---------------------------------------------------

# 1) Disable directory listing
Options -Indexes

# 2) Force HTTPS (if using SSL)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 3) Protect non-public folders
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Deny from all
</IfModule>

# Deny access to folders outside /public
<If "%{REQUEST_URI} =~ m#^/(app|core|routes|storage|vendor)/#">
    Require all denied
</If>
<IfModule !mod_authz_core.c>
    <DirectoryMatch "^(app|core|routes|storage|vendor)">
        Deny from all
    </DirectoryMatch>
</IfModule>

# 4) PHP Security: prevent source code display
<FilesMatch "\.(php|phar)$">
    SetHandler application/x-httpd-php
</FilesMatch>

# 5) Disable server signature
ServerSignature Off
ServerTokens Prod

# 6) Cache static assets (images, CSS, JS)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# 7) Protect .htaccess itself
<Files ".htaccess">
    Require all denied
</Files>

# 8) Redirect index.php internally
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# 9) Disable TRACE & trackback
TraceEnable Off

# 10) Optional: block suspicious user agents
SetEnvIfNoCase User-Agent "libwww-perl" bad_bot
SetEnvIfNoCase User-Agent "wget" bad_bot
<Limit GET POST>
    Order Allow,Deny
    Allow from all
    Deny from env=bad_bot
</Limit>
